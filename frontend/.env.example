# The frontend reads ../.env (the poker repo's .env) in next.config.ts.

# Public Aleo REST API. Next proxies /explorer to this host so the browser
# is not blocked by CORS. The SDK host is then <origin>/explorer/v2.
ENDPOINT=https://api.explorer.provable.com
NETWORK=testnet

# Leave unset on public testnet so the SDK uses the published heights.
CONSENSUS_HEIGHTS=

# Optional Sepolia RPC for ENSv2 resolution and record writes.
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
