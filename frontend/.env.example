# The frontend reads ../.env (the poker repo's .env). Restart next after edits.

# Public Aleo REST API. Next proxies /explorer to this host so the browser
# is not blocked by CORS. The SDK host is then <origin>/explorer/v2.
ENDPOINT=https://api.explorer.provable.com
NETWORK=testnet

# Leave unset on public testnet so the SDK uses the published heights.
CONSENSUS_HEIGHTS=

# Optional Sepolia RPC for ENSv2 resolution and record writes.
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# House funder for the Ethereum play path (never NEXT_PUBLIC_).
# Falls back to PRIVATE_KEY if unset. Amount is public credits in microcredits.
FUNDER_PRIVATE_KEY=
# Public microcredits sent to each temp Aleo key. 1000000 = 1 credit.
# Default buy-in is 5 credits plus fees; 5 million is not enough to play.
FUND_MICROCREDITS=30000000
PROVABLE_API_KEY=
PROVABLE_CONSUMER_ID=
# Optional. SDK setProverUri default is https://api.provable.com/prove
# PROVABLE_API_URL=https://api.provable.com

# Leave 0. NEAR Intents has no testnet; do not send mainnet funds from this app.
NEXT_PUBLIC_INTENTS_ENABLED=0
