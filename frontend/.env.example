# The frontend reads ../.env (the poker repo's .env). Restart next after edits.

# Public Aleo REST API. Next proxies /explorer to this host so the browser
# is not blocked by CORS. The SDK host is then <origin>/explorer/v2.
ENDPOINT=https://api.explorer.provable.com
NETWORK=testnet

# Leave unset on public testnet so the SDK uses the published heights.
CONSENSUS_HEIGHTS=

# Delegated proving for local-key signing. Shield proves in the wallet instead.
PROVABLE_API_KEY=
PROVABLE_CONSUMER_ID=
# Optional. SDK setProverUri default is https://api.provable.com/prove
# PROVABLE_API_URL=https://api.provable.com
